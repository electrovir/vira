    },
    "sideEffects": false,
    "type": "module",
    "scripts": {
        "build": "rm -rf ../../dist && tsx src/build-all.ts && cp ../../dist/book/404.html ../../dist/404.html",
        "compile": "virmator compile",
        "test": "runstorm --names exports,lucide-icons \"npm run test:exports\" \"npm run test:lucide-icons\"",
        "test:exports": "tsx src/vira-scripts/update-all-exports.ts --check",
        "test:lucide-icons": "tsx src/vira-scripts/generate-lucide-icons.ts --check",
        "update:deps": "tsx src/update-internal-deps.ts",
        "update:exports": "tsx src/vira-scripts/update-all-exports.ts",
        "update:lucide-icons": "tsx src/vira-scripts/generate-lucide-icons.ts"
    },
    "dependencies": {
        "@augment-vir/assert": "^32.6.0",
        "@augment-vir/common": "^32.6.0",
        "@augment-vir/node": "^32.6.0",
        "prettier": "^3.4.2",
        "tsx": "^4.23.15"
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "markdown-code-example-inserter": "^3.1.1",
        "runstorm": "^1.1.0",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3"
    },
    "engines": {
        "node": ">=22"
    }
}
